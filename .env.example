# Server Configuration
PORT=5000
NODE_ENV=development

# AI Provider Selection
# Options: 'ollama', 'github', 'gemini'
AI_PROVIDER=ollama

# ==============================================================================
# Ollama Configuration (if AI_PROVIDER=ollama)
# ==============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Recommended models (download with: ollama pull <model>):
# - llama3.2:latest    - Latest from Meta, excellent quality (3B/1B params)
# - qwen2.5:latest     - Latest Alibaba model, great multilingual support
# - gemma2:latest      - Google's latest open model
# - mistral:latest     - Mistral AI's latest, good balance
# - phi3.5:latest      - Microsoft's efficient small model

# ==============================================================================
# GitHub Models Configuration (if AI_PROVIDER=github)
# ==============================================================================
# Get your token from: https://github.com/settings/tokens
# Docs: https://github.com/marketplace/models
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_MODEL=gpt-4o
# Recommended models:
# - gpt-4o             - Latest flagship, best quality (recommended)
# - gpt-4o-mini        - Fast and cost-effective, good for most tasks
# - o1-preview         - Advanced reasoning, slower but more accurate
# - o1-mini            - Reasoning model, faster than o1-preview
# - gpt-4-turbo        - Previous generation, still very capable

# Best Practices:
# - Use gpt-4o for complex travel planning and recommendations
# - Use gpt-4o-mini for quick responses and cost savings
# - Use o1-preview/o1-mini for route optimization reasoning
# - Set temperature=0.7 for creative suggestions, 0.3 for factual

# ==============================================================================
# Google Gemini Configuration (if AI_PROVIDER=gemini)
# ==============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Docs: https://ai.google.dev/gemini-api/docs
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp
# Recommended models:
# - gemini-2.0-flash-exp    - Latest experimental, fastest (recommended)
# - gemini-1.5-pro          - Most capable, best quality
# - gemini-1.5-flash        - Fast and efficient, good balance
# - gemini-1.5-flash-8b     - Fastest, smallest, cost-effective

# Best Practices:
# - Use gemini-2.0-flash-exp for best speed/quality balance
# - Use gemini-1.5-pro for complex multi-step planning
# - Enable safety settings for production
# - Use streaming for better user experience

# ==============================================================================
# Advanced Configuration
# ==============================================================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Add other environment variables as needed
# DATABASE_URL=
# REDIS_URL=

