# Server Configuration
PORT=5000
NODE_ENV=development

# AI Provider Selection
# Options: 'ollama', 'github', 'gemini'
AI_PROVIDER=ollama

# Ollama Configuration (if AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2

# GitHub Models Configuration (if AI_PROVIDER=github)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_MODEL=gpt-4o-mini
# Available models: gpt-4o, gpt-4o-mini, gpt-3.5-turbo, etc.

# Google Gemini Configuration (if AI_PROVIDER=gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Available models: gemini-1.5-pro, gemini-1.5-flash, gemini-pro, etc.

# Optional: Add other environment variables as needed
# DATABASE_URL=
# API_KEY=

